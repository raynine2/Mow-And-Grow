{
  "name": "MowALawn",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "MowALawnBoot": {
        "$path": "src/first",
        "$ignoreUnknownInstances": true
      }
    },
    "ReplicatedStorage": {
      "MowALawn": {
        "$path": "src/shared",
        "$ignoreUnknownInstances": true
      }
    },
    "ServerScriptService": {
      "MowALawn": {
        "$path": "src/server",
        "$ignoreUnknownInstances": true
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "MowALawnClient": {
          "$path": "src/client",
          "$ignoreUnknownInstances": true
        }
      },
      "$properties": {
        "EnableMouseLockOption": true
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future"
      }
    }
  }
}
