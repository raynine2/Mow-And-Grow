-- THE GLITCH DEMON (owner, 27 Oct: the ending teases world 2, "a corrupt world with a demon glitch type of enemy and
-- boss", with a sneak peek in the opening; then "way more detailed"). Our own character, a voxel sculpture in the
-- world's voxel style (client/DemonShape, generated by tools/blender/voxel/demon.py), built from parts on this
-- client only (it only appears in films): a colossal horned demon that heaves itself up out of a fissure, waist up.
--   obsidian hide and violet armour: a plated chest split by glowing cracks round a pulsing core, segmented belly
--   plates, ribs, a spiked spine, layered pauldrons with neon rims and horn spikes; jointed arms with runed bracers,
--   big hands and hooked claws; a skull with a scowling brow, deep sockets with burning slanted eyes, a cyan third
--   eye, banded horns that sweep up and hook in, a fanged snout with a glowing grin, a hinged jaw with a glowing
--   throat, half its face torn into glitching pixels; ragged wings, and loose glitch fragments drifting round it.
-- It glitches: every so often it (or just its head) jumps sideways for a frame or two, or it is cut into bands that
-- slide apart like a torn video frame; red and cyan ghosts of its silhouette split off either side, the corrupted
-- pixels on it flicker and swap colour. Films drive it through `state`:
--   rise  0..1  how far up out of the ground (0 = hidden below `base`)
--   eyes  0..1  shut .. blazing
--   roar  0..1  head back, jaw wide, arms and wings flung open, claws to the sky
-- and call `update(t)` every frame (each body group's blocks are welded to one root, so a frame moves a few roots).
-- `destroy()` when done.
-- Phones and Potato Mode get the LITE build (bigger voxels, half the parts).

local Device = require(script.Parent.Device)
local Potato = require(script.Parent.Potato)
local Shape = require(script.Parent.DemonShape)

local Demon = {}

local MAGENTA = Color3.fromRGB(255, 40, 170)
local CYAN = Color3.fromRGB(60, 240, 255)
local EYE = Color3.fromRGB(255, 52, 110)
local EYE_CORE = Color3.fromRGB(255, 226, 240)
local OBSIDIAN = Color3.fromRGB(26, 14, 34)
local GHOST_RED = Color3.fromRGB(255, 40, 70)
local GHOST_CYAN = Color3.fromRGB(40, 230, 255)
local LIT_VIOLET = Color3.fromRGB(150, 96, 206) -- (opts.lift: what its hide is lifted toward)
local HEIGHT = 42 -- design units, waist to horn tips

-------------------------------------------------------------------------------------------------------------
-- the shape (client/DemonShape), decoded once per level of detail
-------------------------------------------------------------------------------------------------------------
type Box = { size: Vector3, at: Vector3, colour: number, ghost: boolean }
type Group = { name: string, pivot: Vector3, parent: string?, boxes: { Box } }

local DEC: { [number]: number } = {}
for i = 1, #Shape.ALPHA do
	DEC[string.byte(Shape.ALPHA, i)] = i - 1
end

local COLOURS: { Color3 } = {}
for i, e in Shape.PALETTE do
	COLOURS[i] = Color3.fromRGB(e[1], e[2], e[3])
end

local decoded: { [string]: { Group } } = {}
local function level(name: string): { Group }
	local cached = decoded[name]
	if cached then
		return cached
	end
	local out: { Group } = {}
	for _, g in (Shape :: any)[name] do
		local v: number = g.voxel
		local o: Vector3 = g.origin
		local s: string = g.boxes
		local list: { Box } = {}
		for i = 1, #s, 7 do
			local b1, b2, b3, b4, b5, b6, b7 = string.byte(s, i, i + 6)
			local c = DEC[b7]
			local ghost = c >= Shape.GHOST
			if ghost then
				c -= Shape.GHOST
			end
			local size = Vector3.new(DEC[b4], DEC[b5], DEC[b6]) * v
			local at = (Vector3.new(DEC[b1], DEC[b2], DEC[b3]) - o) * v + size / 2
			table.insert(list, { size = size, at = at, colour = c, ghost = ghost })
		end
		table.insert(out, { name = g.name, pivot = g.pivot, parent = g.parent, boxes = list })
	end
	-- loose glitch fragments drifting round it (part of the body's frame)
	local frags: { Box } = {}
	local rng = Random.new(66)
	for _ = 1, 16 do
		local side = if rng:NextNumber() < 0.5 then -1 else 1
		local size = rng:NextNumber(0.6, 1.6)
		table.insert(frags, {
			size = Vector3.one * size,
			at = Vector3.new(side * rng:NextNumber(10, 18), rng:NextNumber(2, 30), rng:NextNumber(-6, 6)),
			colour = -rng:NextInteger(1, 5), -- (negative: a fragment colour, below)
			ghost = false,
		})
	end
	table.insert(out, { name = "frags", pivot = Vector3.zero, parent = "body", boxes = frags })
	decoded[name] = out
	return out
end

local FRAG_COLOURS = { MAGENTA, CYAN, EYE_CORE, OBSIDIAN, MAGENTA }

-- decode ahead of a film (cheap, but keeps the frame the demon appears in clean)
function Demon.preload(lite: boolean?)
	level(if lite then "LITE" else "FULL")
end

function Demon.lite(): boolean
	return Potato.on or Device.touch
end

-------------------------------------------------------------------------------------------------------------
-- building
-------------------------------------------------------------------------------------------------------------
export type Demon = {
	model: Model,
	state: { rise: number, eyes: number, roar: number, glitch: number },
	base: CFrame,
	scale: number,
	height: number,
	update: (t: number) -> (),
	glitchNow: (time: number?) -> (),
	head: () -> CFrame,
	eyes: () -> Vector3,
	destroy: () -> (),
}

export type Options = {
	lite: boolean?, -- the LITE build (default: Demon.lite())
	yieldEvery: number?, -- build in steps, a frame's wait every this many parts (call it in its own thread)
	-- (Films v2 round 2, owner 5 Nov: "u cant really tell whats going on"; in the night it was a black blob)
	calm: boolean?, -- no glitch jumps of its own (only glitchNow), the pixels and fragments flicker less
	lift: number?, -- its dark hide lifted this far (0..1) toward a lit violet, so its shape shows against the night
	outline: Color3?, -- a bright outline round its whole silhouette (a Highlight; api.highlight)
	-- (6 Nov, review of the films: "the demon is an unreadable purple blob ... pink is everywhere at once") its trim
	-- (the untagged neon: rims, runes, cracks, the cyan) dimmed this far toward its dark hide (0..1), so only its eyes,
	-- core, grin and throat burn; and the outline's own see-through-ness and fill
	dim: number?,
	shade: number?, -- its hide (the plain colours) darkened this far toward obsidian (0..1)
	outlineAlpha: number?,
	fillAlpha: number?,
}

local function newPart(model: Model, size: Vector3, colour: Color3, neon: boolean, shadow: boolean): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.Color = colour
	p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.CastShadow = shadow
	p.Parent = model
	return p
end

-- Build the demon (not yet visible: rise 0) standing at `base` (the waist point on the ground, facing its
-- LookVector), `scale` studs per design unit. `parent` defaults to workspace.
function Demon.new(base: CFrame, scale: number, parent: Instance?, opts: Options?): Demon
	local lite = if opts and opts.lite ~= nil then opts.lite else Demon.lite()
	local yieldEvery = opts and opts.yieldEvery
	local calm = opts ~= nil and opts.calm == true
	local liftBy = if opts and opts.lift then math.clamp(opts.lift, 0, 1) else 0
	local dimBy = if opts and opts.dim then math.clamp(opts.dim, 0, 1) else 0
	local shadeBy = if opts and opts.shade then math.clamp(opts.shade, 0, 1) else 0
	local groups = level(if lite then "LITE" else "FULL")
	local model = Instance.new("Model")
	model.Name = "GlitchDemon"

	local pivots: { [string]: Vector3 } = {}
	local groupIndex: { [string]: number } = {}
	for i, g in groups do
		pivots[g.name] = g.pivot
		groupIndex[g.name] = i
	end
	-- Each group's blocks are welded to one invisible anchored root, so a frame moves a handful of roots, not
	-- thousands of blocks (measured in Studio: ~half the cost of moving every block). The loose fragments and the
	-- glitch ghosts are moved one by one.
	local roots: { BasePart } = {}
	local loose: { BasePart } = {}
	local looseRel: { CFrame } = {}
	local looseGroup: { number } = {}
	local tagged: { [string]: { BasePart } } = {}
	local ghostParts: { BasePart } = {}
	local ghostRel: { CFrame } = {}
	local ghostGroup: { number } = {}
	local ghostSide: { number } = {}
	local groupParts: { [number]: { BasePart } } = {} -- (each group's welded blocks: Films v2 splits and shatters it)
	local made = 0
	for gi, g in groups do
		local root: Part? = nil
		if g.name ~= "frags" then
			local r = Instance.new("Part")
			r.Name = "Root_" .. g.name
			r.Anchored = true
			r.CanCollide = false
			r.CanQuery = false
			r.CanTouch = false
			r.Transparency = 1
			r.Size = Vector3.one * 0.2
			r.CFrame = base
			r.Parent = model
			roots[gi] = r
			root = r
		end
		for _, b in g.boxes do
			local colour, neon, tag
			if b.colour < 0 then
				colour = FRAG_COLOURS[-b.colour]
				neon = colour ~= OBSIDIAN
				tag = "frag"
			else
				local e = Shape.PALETTE[b.colour]
				colour, neon, tag = COLOURS[b.colour], e[4], e[5]
			end
			local rel = CFrame.new(b.at * scale)
			if liftBy > 0 and not neon then
				colour = colour:Lerp(LIT_VIOLET, liftBy)
			end
			if shadeBy > 0 and not neon then
				colour = colour:Lerp(OBSIDIAN, shadeBy)
			end
			if dimBy > 0 and neon and tag == nil then
				colour = colour:Lerp(OBSIDIAN, dimBy)
			end
			-- (its grin and throat glowed as one huge magenta mouth that out-shone its eyes: they smoulder now)
			if dimBy > 0 and neon and (tag == "grin" or tag == "throat" or tag == "pix" or tag == "frag") then
				colour = colour:Lerp(OBSIDIAN, dimBy * 0.55)
			end
			local p = newPart(model, b.size * scale, colour, neon, b.ghost)
			if root then
				groupParts[gi] = groupParts[gi] or {}
				table.insert(groupParts[gi], p)
				p.CFrame = base * rel
				local w = Instance.new("WeldConstraint")
				w.Part0 = root
				w.Part1 = p
				w.Parent = p
				p.Anchored = false
			else
				table.insert(loose, p)
				table.insert(looseRel, rel)
				table.insert(looseGroup, gi)
			end
			if tag then
				tagged[tag] = tagged[tag] or {}
				table.insert(tagged[tag], p)
			end
			if b.ghost then
				for _, side in { -1, 1 } do
					local gp = newPart(model, b.size * scale, if side < 0 then GHOST_RED else GHOST_CYAN, true, false)
					gp.Transparency = 1
					table.insert(ghostParts, gp)
					table.insert(ghostRel, rel)
					table.insert(ghostGroup, gi)
					table.insert(ghostSide, side)
				end
			end
			made += 1
			if yieldEvery and made % yieldEvery == 0 then
				task.wait()
			end
		end
	end
	-- light from the eyes and the core
	local function light(tag: string, color: Color3, range: number): PointLight?
		local list = tagged[tag]
		if not list then
			return nil
		end
		local l = Instance.new("PointLight")
		l.Color = color
		l.Range = range * scale
		l.Brightness = 0
		l.Shadows = false
		l.Parent = list[1]
		return l
	end
	local eyeLight = light("eye", EYE, 12)
	local coreLight = light("core", MAGENTA, 14)
	-- the core's two colours (it pulses between them)
	local coreBase: { [BasePart]: Color3 } = {}
	for _, p in tagged.core or {} do
		coreBase[p] = p.Color
	end
	model.Parent = parent or workspace
	-- (opts.outline) its silhouette drawn round in one bright line, as an anime shape against the dark
	local highlight: Highlight? = nil
	if opts and opts.outline then
		local h = Instance.new("Highlight")
		h.Name = "Outline"
		h.Adornee = model
		h.DepthMode = Enum.HighlightDepthMode.Occluded
		h.OutlineColor = opts.outline
		h.OutlineTransparency = opts.outlineAlpha or 0
		h.FillColor = opts.outline
		h.FillTransparency = opts.fillAlpha or 0.94
		h.Parent = model
		highlight = h
	end

	local state = { rise = 0, eyes = 0, roar = 0, glitch = 0 }
	-- (Films v2: a film's own pose on top: hook(frames, groupIndex, t) may move any group's frame, in the world; and a
	-- body cut in two, its top half a group of its own, "top")
	local api: any = { hook = nil }
	local topIndex: number? = nil
	local height = HEIGHT * scale
	local glitchUntil, nextGlitch, jumpHead = 0, os.clock() + 0.8, false
	local jitter = CFrame.identity
	local headCf = CFrame.identity
	local frames: { CFrame } = table.create(#groups, CFrame.identity)
	local lcfs: { CFrame } = table.create(#loose, CFrame.identity)
	local gcfs: { CFrame } = table.create(#ghostParts, CFrame.identity)
	local ghostsShown = false
	-- a "sliced" glitch tears it apart like a video frame: whole pieces (head, jaw, arms, wings...) jump sideways,
	-- and the ghosts are cut into horizontal bands that slide apart
	local BAND = 2.6 * scale
	local slices: { [number]: number } = {}
	local pieceSlices: { number } = table.create(#groups, 0)
	local sliced = false
	local rootY = 0
	local function cutBands()
		for i = -4, 20 do
			slices[i] = if math.random() < 0.4 then (math.random() - 0.5) * 7 * scale else 0
		end
		for i = 1, #groups do
			pieceSlices[i] = if math.random() < 0.45 then (math.random() - 0.5) * 6 * scale else 0
		end
	end

	-- each group's frame this frame (parts sit at frame * rel)
	local function groupFrames(t: number)
		local roar = state.roar
		local breathe = math.sin(t * 1.6)
		local hunch = (1 - state.rise) * (1 - roar) -- hunched over while it climbs out
		local root = base * CFrame.new(0, -(1 - state.rise) * height * 1.05 + breathe * 0.25 * scale, 0) * jitter
		rootY = root.Position.Y
		-- (+X pitch tips the face, which looks down -Z, upward: chest out and head back when it roars)
		-- (6 Nov, review: "the roar is a static T-pose: no head thrown back, no hunch, no lean") it roars like a beast
		-- now: the body lunges forward and trembles, the head is flung back against it, the arms come forward with the
		-- claws spread and raised, not out to the sides
		local tremble = roar * math.sin(t * 46) * 1.4
		local body = root * CFrame.Angles(math.rad(-roar * 14 + tremble + breathe * 0.6 - hunch * 18), 0, math.rad(tremble * 0.5))
		frames[groupIndex.body] = body
		frames[groupIndex.frags] = body
		local head = body * CFrame.new(pivots.head * scale) * CFrame.Angles(math.rad(roar * 38 + math.sin(t * 0.9) * 2.5 - hunch * 14), math.rad(math.sin(t * 0.55) * 6 * (1 - roar)), math.rad(math.sin(t * 0.7) * 2))
		if jumpHead and os.clock() < glitchUntil then
			head *= CFrame.new(scale * (math.random() - 0.5) * 3, 0, 0)
		end
		frames[groupIndex.head] = head
		headCf = head
		-- the jaw hinges at its back: a negative pitch drops its front
		frames[groupIndex.jaw] = head * CFrame.new(pivots.jaw * scale) * CFrame.Angles(-math.rad(roar * 34 + math.max(0, math.sin(t * 2.2)) * 3), 0, 0)
		for _, side in { -1, 1 } do
			local arm = if side < 0 then "armL" else "armR"
			local fore = if side < 0 then "foreL" else "foreR"
			local wing = if side < 0 then "wingL" else "wingR"
			local swing = math.sin(t * 1.1 + side) * 4
			-- arms hang from the shoulders, a little out, forearms reaching forward (+pitch) to the ground; roaring
			-- flings the arms out (roll away from the body) and the forearms up, claws to the sky
			local upper = body * CFrame.new(pivots[arm] * scale) * CFrame.Angles(math.rad(8 + roar * 52 + swing), math.rad(side * roar * 10), math.rad(side * (roar * 26 + 12)))
			frames[groupIndex[arm]] = upper
			frames[groupIndex[fore]] = upper * CFrame.new(pivots[fore] * scale) * CFrame.Angles(math.rad(34 * (1 - roar) + 6 + roar * 26 + swing * 0.6), 0, math.rad(side * roar * 18))
			frames[groupIndex[wing]] = body * CFrame.new(pivots[wing] * scale) * CFrame.Angles(math.rad(10), 0, math.rad(side * (roar * 22 + math.sin(t * 1.8) * 3)))
		end
	end

	local function update(t: number)
		local now = os.clock()
		-- glitch timing: a jump every so often (more often with state.glitch); a calm one only when told (glitchNow)
		if calm and now >= nextGlitch and state.glitch <= 0 then
			nextGlitch = now + 0.25
		end
		if now >= nextGlitch then
			glitchUntil = now + 0.05 + math.random() * 0.1
			nextGlitch = now + (0.5 + math.random() * 1.6) / (1 + state.glitch * 3)
			local roll = math.random()
			jumpHead = roll < 0.3
			sliced = roll >= 0.3 and roll < 0.75
			if sliced then
				cutBands()
			elseif not jumpHead then
				jitter = CFrame.new(scale * (math.random() - 0.5) * 4, scale * (math.random() - 0.5) * 1.2, 0)
			end
		elseif now >= glitchUntil then
			jitter = CFrame.identity
			jumpHead = false
			sliced = false
		end
		local glitching = now < glitchUntil
		groupFrames(t)
		if topIndex then
			frames[topIndex] = frames[groupIndex.body]
		end
		if api.hook then
			api.hook(frames, groupIndex, t)
		end
		-- (glitches push across the screen: the camera's right)
		local cam = workspace.CurrentCamera
		local right = if cam then cam.CFrame.RightVector else Vector3.xAxis
		local cutting = glitching and sliced
		if cutting then
			for gi = 1, #groups do
				local off = pieceSlices[gi]
				if off ~= 0 then
					frames[gi] += right * off
				end
			end
		end
		for gi, r in roots do
			r.CFrame = frames[gi]
		end
		for i = 1, #loose do
			lcfs[i] = CFrame.new(0, math.sin(t * 2 + i) * 0.6 * scale, 0) * frames[looseGroup[i]] * looseRel[i]
		end
		workspace:BulkMoveTo(loose, lcfs, Enum.BulkMoveMode.FireCFrameChanged)
		-- the red / cyan ghosts split off either side while it glitches (left alone while they're invisible)
		local ghostAlpha = if glitching then 0.45 else (1 - 0.35 * state.glitch)
		if ghostAlpha < 1 then
			local spread = if glitching then 1.6 * scale else (0.25 + state.glitch * 0.6) * scale
			for i = 1, #ghostParts do
				local cf = frames[ghostGroup[i]] * ghostRel[i] + right * (spread * ghostSide[i])
				if cutting then
					local off = slices[math.floor((cf.Position.Y - rootY) / BAND)]
					if off and off ~= 0 then
						cf += right * off
					end
				end
				gcfs[i] = cf
			end
			workspace:BulkMoveTo(ghostParts, gcfs, Enum.BulkMoveMode.FireCFrameChanged)
		end
		if ghostAlpha < 1 or ghostsShown then
			local a = math.max(ghostAlpha, 0.45)
			for _, g in ghostParts do
				g.Transparency = a
			end
			ghostsShown = ghostAlpha < 1
		end
		-- eyes, third eye, grin, throat, core, corrupted pixels, fragments
		local eyeOn = state.eyes
		for _, p in tagged.eye or {} do
			p.Transparency = 1 - eyeOn
		end
		for _, p in tagged.eye3 or {} do
			p.Transparency = if eyeOn > 0.5 and (math.sin(t * 9) > -0.6 or glitching) then 0 else 1
		end
		for _, p in tagged.grin or {} do
			p.Transparency = 1 - eyeOn * 0.9
		end
		for _, p in tagged.throat or {} do
			p.Transparency = 1 - math.clamp(state.roar * 1.4, 0, 1)
		end
		local flicker = if calm then 0.015 else 0.06
		for _, p in tagged.pix or {} do
			if glitching then
				p.Transparency = 0
				p.Color = if math.random() < 0.5 then MAGENTA else CYAN
			elseif math.random() < flicker then
				p.Transparency = if p.Transparency > 0.5 then 0 else 1
				p.Color = if math.random() < 0.7 then MAGENTA else CYAN
			end
		end
		local gone = if calm then 0.02 else 0.08
		for _, p in tagged.frag or {} do
			p.Transparency = if math.random() < gone then 1 else 0
		end
		local pulse = 0.5 + 0.5 * math.sin(t * 3.4)
		for p, c in coreBase do
			p.Color = c:Lerp(EYE_CORE, pulse * 0.5)
		end
		if eyeLight then
			eyeLight.Brightness = eyeOn * (2 + state.roar * 3)
		end
		if coreLight then
			coreLight.Brightness = 1.2 + pulse * 1.8
		end
	end

	-- (built out of the world, e.g. to come out later: its welds only take their offsets once it's put in, so the
	-- first pose waits; call update() after parenting it)
	if model:IsDescendantOf(workspace) then
		update(0)
	end
	api.model = model
	api.state = state
	api.highlight = highlight
	api.base = base
	api.scale = scale
	api.height = height
	api.update = update
	-- force a glitch right now (lasting `time`, default a couple of frames): it slices and jumps
	api.glitchNow = function(time: number?)
		glitchUntil = os.clock() + (time or 0.08)
		jumpHead = false
		sliced = true
		cutBands()
		jitter = CFrame.new(scale * (math.random() - 0.5) * 5, 0, 0)
	end
	api.head = function(): CFrame
		return headCf
	end
	-- the point between its eyes (for close-ups)
	api.eyes = function(): Vector3
		return (headCf * CFrame.new(Shape.EYES * scale)).Position
	end
	-- a group's frame this frame (e.g. "armR"), and where its pivot is
	api.frame = function(name: string): CFrame
		return frames[groupIndex[name] or 1]
	end
	-- (Films v2) cut the body in two at `y` design units over the waist: the blocks above it go to a group of their
	-- own ("top", following the body until a hook moves it); the head, arms, wings and fragments go with it
	api.split = function(y: number)
		if topIndex then
			return
		end
		local bi = groupIndex.body
		local bodyCf = frames[bi]
		local r = Instance.new("Part")
		r.Name = "Root_top"
		r.Anchored = true
		r.CanCollide = false
		r.CanQuery = false
		r.CanTouch = false
		r.Transparency = 1
		r.Size = Vector3.one * 0.2
		r.CFrame = bodyCf
		r.Parent = model
		local ti = #frames + 1
		frames[ti] = bodyCf
		roots[ti] = r
		groupIndex.top = ti
		groupParts[ti] = {}
		local keepList = {}
		for _, p in groupParts[bi] or {} do
			if bodyCf:PointToObjectSpace(p.Position).Y > y * scale then
				local w = p:FindFirstChildOfClass("WeldConstraint")
				if w then
					w.Enabled = false
					w.Part0 = r
					w.Enabled = true
				end
				table.insert(groupParts[ti], p)
			else
				table.insert(keepList, p)
			end
		end
		groupParts[bi] = keepList
		topIndex = ti
	end
	-- n blocks picked through it (where they are, their size and colour), for a shatter drawn by the film
	api.samples = function(n: number): { { cf: CFrame, size: Vector3, color: Color3 } }
		local all = {}
		for _, list in groupParts do
			for _, p in list do
				table.insert(all, p)
			end
		end
		local out = {}
		for _ = 1, math.min(n, #all) do
			local p = all[math.random(1, #all)]
			table.insert(out, { cf = p.CFrame, size = p.Size, color = p.Color })
		end
		return out
	end
	-- (Films v2) a lens inside it or right against it sees through: the blocks within `margin` studs of `pos` are hidden
	-- on this client (the ones hidden before and clear now come back); nil shows them all. Each group's blocks keep
	-- their place on its root, so a group is only looked through when `pos` is inside its box.
	local relOf: { [BasePart]: Vector3 } = {}
	local boxOf: { [number]: { lo: Vector3, hi: Vector3 } } = {}
	local clipped: { [BasePart]: boolean } = {}
	api.nearClip = function(pos: Vector3?, margin: number?)
		local m = margin or 0.8
		local hide: { [BasePart]: boolean } = {}
		if pos then
			for gi, r in roots do
				local list = groupParts[gi]
				if list and #list > 0 then
					local rcf = r.CFrame
					local box = boxOf[gi]
					if not box then
						local lo, hi = Vector3.one * math.huge, -Vector3.one * math.huge
						for _, p in list do
							local rel = relOf[p] or rcf:PointToObjectSpace(p.Position)
							relOf[p] = rel
							lo = lo:Min(rel - p.Size / 2)
							hi = hi:Max(rel + p.Size / 2)
						end
						box = { lo = lo, hi = hi }
						boxOf[gi] = box
					end
					local q = rcf:PointToObjectSpace(pos)
					if q.X > box.lo.X - m and q.Y > box.lo.Y - m and q.Z > box.lo.Z - m and q.X < box.hi.X + m and q.Y < box.hi.Y + m and q.Z < box.hi.Z + m then
						for _, p in list do
							local rel = relOf[p]
							if rel then
								local d = q - rel
								local h = p.Size / 2
								if math.abs(d.X) < h.X + m and math.abs(d.Y) < h.Y + m and math.abs(d.Z) < h.Z + m then
									hide[p] = true
								end
							end
						end
					end
				end
			end
		end
		for p in clipped do
			if not hide[p] then
				p.LocalTransparencyModifier = 0
			end
		end
		for p in hide do
			if not clipped[p] then
				p.LocalTransparencyModifier = 1
			end
		end
		clipped = hide
	end
	api.destroy = function()
		model:Destroy()
	end
	return api
end

return Demon
