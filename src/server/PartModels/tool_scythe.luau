-------------------------------------------------------------------------------------------------------------
-- (30 Oct, owner: "improve the model so it looks cooler and higher quality, so players want to buy it") the
-- Mega Scythe's finish, on top of the generated model above: polished silver bands up the snath, glowing rune
-- inlays between them, a crystal in an obsidian claw at the butt, gem eyes in the head, a spike off its back,
-- a soft glow round the blade's edge, sparkles drifting off it and a violet light (dress, below). Everything is
-- plain parts: no upload, cheap on phones. The shop's display, your hands and everyone else's all use this model.
-------------------------------------------------------------------------------------------------------------
spec.prefer = true -- (server/Models: use this, not the old upload)
table.insert(spec.materials, "Metal__D8C9F5") -- 5 polished silver-lavender
table.insert(spec.materials, "Neon__F4E2FF") -- 6 white-hot crystal
table.insert(spec.materials, "Neon__BA54FF__T65") -- 7 soft violet glow
table.insert(spec.materials, "Metal__1E1428") -- 8 obsidian
local SILVER, CRYSTAL, GLOW, OBSIDIAN, RUNE = 5, 6, 7, 8, 4

local function add(shape: string, size: Vector3, cf: CFrame, mat: number, name: string?)
	local p: { any } = { shape, size.X, size.Y, size.Z }
	for _, v in { cf:GetComponents() } do
		table.insert(p, math.round(v * 1000) / 1000)
	end
	table.insert(p, mat)
	if name then
		table.insert(p, name)
	end
	table.insert(spec.parts, p)
end
local ALONG = CFrame.Angles(0, math.rad(90), 0) -- a cylinder's length along the snath (-Z)

-- silver bands: either side of the grip wrap, and in pairs up the snath
for _, z in { 0.72, -0.72, -1.05, -1.2, -3.3, -4.85, -5.0 } do
	add("C", Vector3.new(0.09, 0.56, 0.56), CFrame.new(0, 0, z) * ALONG, SILVER)
end
-- glowing rune inlays on both faces of the snath (the sides you see it from), in two runs between the bands
for _, z in { -1.45, -1.8, -2.95, -3.55, -3.9, -4.25, -4.6 } do
	for _, a in { 0, math.pi } do
		add("B", Vector3.new(0.05, 0.13, 0.2), CFrame.new(math.cos(a) * 0.235, math.sin(a) * 0.235, z) * CFrame.Angles(0, 0, a), RUNE)
	end
end
-- the butt: an obsidian claw holding a crystal, in a soft halo
add("C", Vector3.new(0.26, 0.5, 0.5), CFrame.new(0, 0, 1.98) * ALONG, OBSIDIAN)
for k = 0, 3 do
	local a = k * math.pi / 2 + math.rad(45)
	add("W", Vector3.new(0.08, 0.34, 0.2), CFrame.new(math.cos(a) * 0.2, math.sin(a) * 0.2, 2.2) * CFrame.Angles(0, 0, a - math.pi / 2) * CFrame.Angles(math.rad(180), 0, 0), OBSIDIAN)
end
add("B", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0, 0, 2.32) * CFrame.Angles(math.rad(45), math.rad(35.26), 0), CRYSTAL, "PommelGem")
add("S", Vector3.new(0.58, 0.58, 0.58), CFrame.new(0, 0, 2.32), GLOW)
-- the head: gem eyes on both sides, each in a halo, and an obsidian fin off its back (away from the blade) with a
-- glowing edge
for _, x in { -0.37, 0.37 } do
	add("S", Vector3.new(0.3, 0.3, 0.3), CFrame.new(x, 0.05, -5.55), CRYSTAL)
	add("S", Vector3.new(0.5, 0.5, 0.5), CFrame.new(x * 1.05, 0.05, -5.55), GLOW)
end
add("W", Vector3.new(0.12, 1.1, 0.32), CFrame.new(0, -0.75, -5.39) * CFrame.Angles(math.rad(180), 0, 0), OBSIDIAN)
add("W", Vector3.new(0.12, 1.1, 0.32), CFrame.new(0, -0.75, -5.71) * CFrame.Angles(math.rad(180), math.rad(180), 0), OBSIDIAN)
add("W", Vector3.new(0.05, 0.9, 0.12), CFrame.new(0, -0.65, -5.33) * CFrame.Angles(math.rad(180), 0, 0), RUNE)
add("S", Vector3.new(0.14, 0.14, 0.14), CFrame.new(0, -0.28, -5.5), CRYSTAL)

-- Effects that plain part data can't carry (server/Models calls this once on the built template).
spec.dress = function(model: Model)
	local edge = {}
	for _, p in model:GetChildren() do
		-- the blade's glowing inner edge: the thin neon slabs along it
		if p:IsA("Part") and p.Material == Enum.Material.Neon and p.Shape == Enum.PartType.Block and math.abs(p.Size.X - 0.133) < 0.01 then
			table.insert(edge, p)
		end
	end
	for _, p in edge do
		-- a faint glow a little wider than the edge (any stronger and it washes out the dark spine)
		local halo = p:Clone()
		halo.Name = "EdgeGlow"
		halo.Size = Vector3.new(0.2, p.Size.Y * 1.04, p.Size.Z * 1.12)
		halo.Transparency = 0.82
		halo.CastShadow = false
		halo.Parent = model
		-- sparkles drifting off the edge
		local e = Instance.new("ParticleEmitter")
		e.Name = "EdgeSparkle"
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Color = ColorSequence.new(Color3.fromRGB(255, 235, 255), Color3.fromRGB(186, 84, 255))
		e.LightEmission = 1
		e.LightInfluence = 0
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.22), NumberSequenceKeypoint.new(1, 0) })
		e.Transparency = NumberSequence.new(0.1, 1)
		e.Lifetime = NumberRange.new(0.5, 0.9)
		e.Rate = 1.6
		e.Speed = NumberRange.new(0.2, 0.6)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-90, 90)
		e.Drag = 2
		e.Parent = p
	end
	-- a violet light in the blade's curve, and a faint one in the pommel's crystal
	local core = Instance.new("Part")
	core.Name = "BladeLight"
	core.Size = Vector3.new(0.1, 0.1, 0.1)
	core.Transparency = 1
	core.CanCollide = false
	core.CanQuery = false
	core.CanTouch = false
	core.CastShadow = false
	core.Anchored = true
	core.CFrame = CFrame.new(0, 3.502, -4.527) -- (in the curve of the blade)
	core.Parent = model
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(190, 110, 255)
	light.Range = 9
	light.Brightness = 1.3
	light.Parent = core
	local gem = model:FindFirstChild("PommelGem")
	if gem then
		local l2 = Instance.new("PointLight")
		l2.Color = Color3.fromRGB(230, 190, 255)
		l2.Range = 3.5
		l2.Brightness = 1
		l2.Parent = gem
	end
end

return spec
